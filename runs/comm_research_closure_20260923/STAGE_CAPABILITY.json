 "round": "comm_research_closure_20260923",
 "stages": [
  {
   "evidence_kind": "derived_from_config",
   "fields": [
    "run_config detail.configuration.num_goals (per episode)"
   ],
   "key": "placed",
   "stage": 1,
   "what": "a goal exists in the scenario, whether or not anything ever finds it",
   "why_not_direct": "no record is emitted for a goal that nothing detects, so the denominator of 'never discovered' is only the configured count, and duplicate/merged detections would make placed != distinct target ids without any log saying so"
  },
  {
   "evidence_kind": "direct",
   "fields": [
    "detection: timestamp, discovered_by, source_event_id, detail.grid_position",
    "detail.confidence, detail.total_stages, detail.deadline_offset"
   ],
   "key": "search_discovered",
   "stage": 2,
   "what": "a search robot detected the goal and the registry accepted it",
   "why_not_direct": null
  },
  {
   "evidence_kind": "direct_only_where_transcript_enabled",
   "fields": [
    "send: step, target, first, cost_bytes, attempts (billed), packets (arrived), packets_lost, subscribers (a COUNT)",
    "deliver: step, target, agent, revision, accepted, reason",
    "refused: step, target, reason, cost_bytes, remaining_bytes"
   ],
   "key": "message_delivered",
   "stage": 3,
   "what": "a message carrying the goal was transmitted and reached a receiver",
   "why_not_direct": "per send the ledger closes as attempts == packets + packets_lost (checked in the probe), but neither side names *which* subscriber lost the packet, so 'this robot never received it' cannot be read back; and the deployed-path runs before comm_rule_confirm carry no transcript at all"
  },
  {
   "evidence_kind": "inferred",
   "fields": [
    "deliver accepted=true is the only per-(goal, robot) knowledge record"
   ],
   "key": "robot_knew",
   "stage": 4,
   "what": "this specific rescue robot's belief now contains the goal",
   "why_not_direct": "belief updates are never logged as their own event, and they also happen through three non-message channels (line-of-sight refresh, one-hop gossip, on-arrival verify), so 'knew' cannot be separated from 'was told' without the probe counts"
  },
  {
   "evidence_kind": "direct_with_caveat",
   "fields": [
    "assignment: timestamp, assigned_agents, detail.command_id/reason/valid_until",
    "progress status 'en_route'"
   ],
   "key": "allocated",
   "stage": 5,
   "what": "an assignment command naming this goal was issued and accepted",
   "why_not_direct": "assignment records are written with target_id '__run__' whenever the command carries no target id, so goal linkage is per-run, not guaranteed; the practical chain key is the first 'en_route' progress record"
  },
  {
   "evidence_kind": "proxy",
   "fields": [
    "progress status 'assigned' (members non-empty, work not yet feasible)",
    "decision trace truth.targets[*].on_site"
   ],
   "key": "arrived",
   "stage": 6,
   "what": "an assigned robot is physically at the goal",
   "why_not_direct": "progress records are emitted only on a fingerprint change, so a robot that arrives and starts working between two polls produces no 'assigned' row at all; arrival time is therefore an upper bound, not a measurement"
  },
  {
   "evidence_kind": "proxy",
   "fields": [
    "progress status 'in_progress', stage_index, progress, remaining_requirements"
   ],
   "key": "started_work",
   "stage": 7,
   "what": "the stage requirement is covered and the clock is running",
   "why_not_direct": "the same fingerprint rule applies; additionally a coverage break resets time_left to the full stage duration, so 'working' is not a monotone quantity and elapsed work cannot be read off the progress fraction"
  },
  {
   "evidence_kind": "direct",
   "fields": [
    "final: status, detail.deadline, detail.discovered_at, detail.updated_at",
    "progress status 'completed' / 'expired'"
   ],
   "key": "outcome",
   "stage": 8,
   "what": "completed on time, completed late, expired, or unresolved",
   "why_not_direct": null
  }
 ]
