{
 "arms": [
  "v4f@200"
 ],
 "caveats": [
  "the 120 worlds are 15 cells x 8 scenes; the eight scenes of one cell share its goal count and rescue roster, so the pairs are not fully independent",
  "one world has zero on-time tasks (slack_matched_rate), so messages_per_on_time is computed on 119/120 pairs there and the exclusion is printed",
  "byte_ratio is the mean of per-world ratios, not the ratio of the group totals",
  "24 t tests: a raw p of 0.05 is not evidence at that level; read the Holm column",
  "no seed replication exists, so the CI covers world-to-world variation only"
 ],
 "comparators": [
  "normal_immediate",
  "slack_heuristic_cap",
  "slack_matched_rate",
  "random_matched_rate"
 ],
 "holm_families": 3,
 "holm_family_size": 24,
 "primary_test": "wilcoxon signed-rank, Holm-adjusted within scope (24 tests/family); Shapiro-Wilk rejects normality in all 72 scopes so the t interval is descriptive",
